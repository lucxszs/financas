# Config pública do app Web do Firebase (Console > Configurações do projeto > Seus apps).
# Não é segredo: vai para o navegador de qualquer forma. A proteção dos dados vem
# do Firebase Auth + firestore.rules. Mantido fora do git só para o repo ser genérico.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
