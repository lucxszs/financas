# Usado por `npm run dev:emulador`. Valores fictícios: tudo roda nos emuladores locais.
# O prefixo "demo-" faz o Firebase CLI bloquear qualquer acesso a serviços reais.
VITE_USE_EMULATORS=true
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-financas.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-financas
VITE_FIREBASE_STORAGE_BUCKET=demo-financas.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:demo
