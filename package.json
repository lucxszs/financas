{
  "name": "financas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "firebase emulators:exec --only firestore --project demo-financas \"vitest run --config vitest.rules.config.ts\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "dev:emulador": "firebase emulators:exec --only auth,firestore --project demo-financas \"node scripts/seed-emulador.mjs && vite --mode emulador\""
  },
  "dependencies": {
    "country-flag-icons": "^1.6.20",
    "firebase": "^12.19.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.33.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
